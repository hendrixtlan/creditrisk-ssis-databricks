{
  "name": "DS_LANDING_CSV",
  "properties": {
    "linkedServiceName": {
      "referenceName": "LS_ADLS",
      "type": "LinkedServiceReference"
    },
    "parameters": {
      "folder": {
        "type": "String"
      },
      "file": {
        "type": "String"
      }
    },
    "type": "DelimitedText",
    "typeProperties": {
      "location": {
        "type": "AzureBlobFSLocation",
        "fileSystem": "landing",
        "folderPath": {
          "value": "@dataset().folder",
          "type": "Expression"
        },
        "fileName": {
          "value": "@dataset().file",
          "type": "Expression"
        }
      },
      "columnDelimiter": ",",
      "escapeChar": "\\",
      "firstRowAsHeader": true,
      "quoteChar": "\""
    }
  }
}
